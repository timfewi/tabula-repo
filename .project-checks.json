{
  "version": 1,
  "checks": [
    {
      "name": "nix-format",
      "argv": [
        "nixfmt",
        "--check",
        "flake.nix"
      ],
      "requires": [
        "nixfmt"
      ],
      "timeout_seconds": 120,
      "profiles": [
        "fast"
      ]
    },
    {
      "name": "statix",
      "argv": [
        "statix",
        "check",
        "."
      ],
      "requires": [
        "statix"
      ],
      "timeout_seconds": 120,
      "profiles": [
        "fast"
      ]
    },
    {
      "name": "deadnix",
      "argv": [
        "deadnix",
        "--fail",
        "."
      ],
      "requires": [
        "deadnix"
      ],
      "timeout_seconds": 120,
      "profiles": [
        "fast"
      ]
    },
    {
      "name": "ruff-check",
      "argv": [
        "ruff",
        "check",
        "."
      ],
      "requires": [
        "ruff"
      ],
      "timeout_seconds": 120,
      "profiles": [
        "fast"
      ]
    },
    {
      "name": "ruff-format",
      "argv": [
        "ruff",
        "format",
        "--check",
        "."
      ],
      "requires": [
        "ruff"
      ],
      "timeout_seconds": 120,
      "profiles": [
        "fast"
      ]
    },
    {
      "name": "python-tests",
      "argv": [
        "python3",
        "-m",
        "unittest",
        "discover",
        "-s",
        "tests"
      ],
      "requires": [
        "python3"
      ],
      "timeout_seconds": 60,
      "profiles": [
        "fast"
      ]
    },
    {
      "name": "flake-check",
      "argv": [
        "nix",
        "flake",
        "check",
        "--no-write-lock-file",
        "path:."
      ],
      "requires": [
        "nix"
      ],
      "timeout_seconds": 900,
      "profiles": [
        "full"
      ]
    }
  ],
  "watch_ignore": [
    ".direnv",
    "result",
    "result-*",
    ".venv"
  ]
}
