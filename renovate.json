{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "packageRules": [
    {
      "description": "Platform packages are released in lockstep with Tabula and must not be updated independently.",
      "matchManagers": ["npm"],
      "matchPackageNames": [
        "tabula-repo-x86_64-unknown-linux-musl",
        "tabula-repo-aarch64-unknown-linux-musl",
        "tabula-repo-x86_64-apple-darwin",
        "tabula-repo-aarch64-apple-darwin",
        "tabula-repo-x86_64-pc-windows-msvc"
      ],
      "enabled": false
    }
  ]
}
